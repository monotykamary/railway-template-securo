server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # API proxy to backend over Railway private networking.
    # Railway's private DNS (.railway.internal) is served by the platform
    # resolver at fd12::10 (port 53). Public resolvers cannot see it.
    # Resolve at request time so backend redeploys with new IPs keep working.
    resolver [fd12::10]:53 valid=10s ipv6=on;
    set $upstream ${BACKEND_URL};
    location /api/ {
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
